# Copy to .env and edit. Never commit real secrets (.env is git-ignored).

PORT=8080

# local | prod | test
SPRING_PROFILES_ACTIVE=local

# --- Database (required) ---
DB_URL=jdbc:postgresql://localhost:5432/seatres
DB_USERNAME=seatres
DB_PASSWORD=change-me

# --- Pool and timeouts (optional; defaults shown) ---
# Keep DB_POOL_MAX_SIZE + 2 below the server's max_connections.
DB_POOL_MAX_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=35000

# --- Auth (required outside profile 'local') ---
# Generate each with: openssl rand -base64 48   (>= 32 bytes, different values)
# The JWT secret is never shared; the admin key is shared privately and rotated afterwards.
APP_AUTH_JWT_SECRET=replace-with-openssl-rand-base64-48-at-least-32-bytes
APP_AUTH_ADMIN_KEY=replace-with-a-different-openssl-rand-base64-48-value

# --- Idempotency (optional) ---
# ISO-8601 duration, >= PT24H.
APP_IDEMPOTENCY_RETENTION=PT24H

# --- JVM (optional) ---
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
